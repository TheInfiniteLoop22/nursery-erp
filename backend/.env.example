# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/neondb?sslmode=require
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3030,http://localhost:3000

# Optional: a separate database (e.g. a Neon "test" branch) used only by pytest
# TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/neondb?sslmode=require
